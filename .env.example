# Shared base URL for all frontend API requests. Keep the /api/v1 suffix.
# Set this variable in your frontend hosting settings before building, too.
VITE_API_BASE_URL=https://journeylog-backend.vercel.app/api/v1

# To use a local backend instead, set this in .env.local and restart Vite:
# VITE_API_BASE_URL=http://localhost:3001/api/v1
